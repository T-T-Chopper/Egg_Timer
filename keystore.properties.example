# Release imzalama yapılandırması
# 1. Bu dosyayı "keystore.properties" adıyla kopyalayın (git'e girmez)
# 2. Keystore oluşturun:
#    keytool -genkey -v -keystore eggtimer-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias eggtimer
# 3. Aşağıdaki değerleri kendi bilgilerinizle doldurun
#
# ÖNEMLİ: eggtimer-release.jks dosyasını güvenli bir yerde YEDEKLEYİN.
# Kaybederseniz uygulamayı Play Store'da bir daha güncelleyemezsiniz!

storeFile=eggtimer-release.jks
storePassword=BURAYA_STORE_SIFRESI
keyAlias=eggtimer
keyPassword=BURAYA_KEY_SIFRESI
