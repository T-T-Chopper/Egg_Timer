<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Süre dolduğunda titreşim -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Zamanlayıcı arka plandayken süre dolduğunda bildirim göstermek için -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Yumurta zamanlayıcısının alarmı dakikası dakikasına çalmalı; birkaç dakika
      geciken bir alarm yumurtayı fazla pişirir. Android 12 öncesi için
      SCHEDULE_EXACT_ALARM, sonrası için USE_EXACT_ALARM kullanılır. İzin
      alınamazsa alarm yaklaşık zamanlamaya düşer, uygulama çalışmaya devam eder.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EggTimer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EggTimer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />
    </application>

</manifest>