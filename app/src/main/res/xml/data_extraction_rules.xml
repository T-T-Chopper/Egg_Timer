<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules file for Egg Timer app.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include SharedPreferences for language preference -->
        <include domain="sharedpref" path="EggTimerPrefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Include SharedPreferences for device transfer -->
        <include domain="sharedpref" path="EggTimerPrefs.xml"/>
    </device-transfer>
</data-extraction-rules>